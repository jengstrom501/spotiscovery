# Copy to .env and fill in. See README for where each one comes from.

# Required: your own Spotify app's Client ID (no secret needed, PKCE login)
SPOTIFY_CLIENT_ID=

# Required: free Last.fm API key, source of similar artists and genre tags
LASTFM_API_KEY=

# Optional: enables "Ask Claude" blends
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Optional overrides
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# DEEP_CUTS_DB=deep_cuts.db
